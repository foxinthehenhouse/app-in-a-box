{
  "expo": {
    "name": "__APP_NAME__",
    "slug": "__APP_SLUG__",
    "scheme": "__SCHEME__",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "__BUNDLE_ID__",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "__BUNDLE_ID__",
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-router",
      "@sentry/react-native/expo",
      "expo-notifications",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "extra": {
      "appDomain": ""
    }
  }
}
