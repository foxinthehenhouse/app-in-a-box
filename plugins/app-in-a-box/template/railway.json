{
  "$schema": "https://railway.com/railway.schema.json",
  "deploy": {
    "startCommand": "uvicorn backend.main:app --host 0.0.0.0 --port $PORT --workers 2 --no-server-header --timeout-graceful-shutdown 20",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 60,
    "overlapSeconds": 30,
    "drainingSeconds": 25,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
