# Copy to .env (gitignored). The provision phase fills this in; never commit values.
# development | preview | production (Railway sets production)
APP_ENV=

# Supabase: supabase projects api-keys --project-ref <ref>
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=

# Backend URL (Railway domain once deployed; http://<LAN-IP>:8000 for a device in dev)
API_URL=

# Sentry: project keys page (backend DSN)
SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# PostHog: project settings (public project key) + personal API key (provisioning only)
POSTHOG_API_KEY=
POSTHOG_PERSONAL_API_KEY=

# Anthropic: only if appbox.yaml ai.enabled
ANTHROPIC_API_KEY=

# CI: expo.dev access token; `claude setup-token`
EXPO_TOKEN=
CLAUDE_CODE_OAUTH_TOKEN=

# Scheduled jobs: openssl rand -hex 32 (Railway variable + GitHub secret)
CRON_SECRET=
# Optional: only with Expo "enhanced push security"
EXPO_ACCESS_TOKEN=
# Browser origins, comma-separated (mobile needs none)
CORS_ORIGINS=
# json for one-object-per-line logs
LOG_FORMAT=
