# Copy to .env (gitignored). The provision phase fills this in; never commit values.
# development | preview | production (Railway sets production)
APP_ENV=

# Supabase: supabase projects api-keys --project-ref <ref>
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=

# Supabase Management API (provisioning only, never on Railway): a personal access
# token from supabase.com/dashboard/account/tokens, for auth settings and custom SMTP
SUPABASE_ACCESS_TOKEN=

# Auth email (custom SMTP, sent by Supabase): for Resend, the API key from
# resend.com/api-keys. Provisioning only; it lives in Supabase, never on Railway.
SMTP_PASS=
# The SMTP host, set on Railway once Supabase has the SMTP config (/health checks it)
AUTH_SMTP_HOST=

# Backend URL (Railway domain once deployed; http://<LAN-IP>:8000 for a device in dev)
API_URL=

# Sentry: project keys page (backend DSN)
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
# Share of API requests traced (default 0.05, capped at 0.25; /health is never traced)
SENTRY_TRACES_SAMPLE_RATE=

# PostHog: project settings (public project key) + personal API key (provisioning only)
POSTHOG_API_KEY=
POSTHOG_PERSONAL_API_KEY=
# The same host as EXPO_PUBLIC_POSTHOG_HOST; the API reads feature flags from it
POSTHOG_HOST=
# Feature-flag overrides for the API (backend/flags.py): FLAG_KILL_PUSH=1 forces the
# kill switch on without PostHog. Leave unset normally.

# Account erasure (optional, Railway): deleting an account also deletes the user's
# PostHog person + events and their Sentry issues once these are set. Use keys scoped
# to that one job, never the provisioning ones above. See backend/services/erasure_service.py.
# PostHog: a personal API key with only person:write; the private API host
# (https://us.posthog.com or https://eu.posthog.com) and the numeric project id.
POSTHOG_ERASURE_KEY=
POSTHOG_PROJECT_ID=
POSTHOG_API_HOST=
# Sentry: an auth token with only event:admin; org slug; project slugs, comma-separated
SENTRY_ERASURE_TOKEN=
SENTRY_ORG=
SENTRY_PROJECTS=

# Anthropic: only if appbox.yaml ai.enabled
ANTHROPIC_API_KEY=

# CI: `claude setup-token` (EAS Workflows need no Expo token: the expo.dev GitHub app)
CLAUDE_CODE_OAUTH_TOKEN=

# Scheduled jobs: openssl rand -hex 32 (Railway variable + GitHub secret)
CRON_SECRET=
# Optional: only with Expo "enhanced push security"
EXPO_ACCESS_TOKEN=
# Browser origins, comma-separated (mobile needs none)
CORS_ORIGINS=
# json for one-object-per-line logs
LOG_FORMAT=
