{
  "$schema": "tokens v2: color.light + color.dark, motion, type roles, elevation, opacity. Validate with scripts/check_contrast.py",
  "name": "fixture-alt",
  "version": 2,
  "mode": "light",
  "color": {
    "light": {
      "bg": "#FFF7EC",
      "surface": "#FFFFFF",
      "surfaceRaised": "#FFFFFF",
      "control": "#F6EDE0",
      "border": "#EADFCF",
      "ink": "#2B1B3D",
      "inkDim": "#5E4E71",
      "inkFaint": "#6A5A7D",
      "accent": "#7B3FE4",
      "onAccent": "#FFFFFF",
      "success": "#1F8A5B",
      "warning": "#B86B00",
      "danger": "#C8324B",
      "shadow": "#2B1B3D"
    },
    "dark": {
      "bg": "#1A1224",
      "surface": "#241A30",
      "surfaceRaised": "#2C2139",
      "control": "#241A30",
      "border": "#3D3050",
      "ink": "#FFF3E4",
      "inkDim": "#D9C9E6",
      "inkFaint": "#B4A3C4",
      "accent": "#FF9A5A",
      "onAccent": "#2B1B3D",
      "success": "#4ED39A",
      "warning": "#FFC24D",
      "danger": "#FF7A8A",
      "shadow": "#000000"
    }
  },
  "font": {
    "display": "Baloo 2",
    "body": "System",
    "mono": "Menlo"
  },
  "type": {
    "display": {
      "font": "display",
      "size": 44,
      "lineHeight": 48,
      "weight": "800",
      "letterSpacing": -0.6,
      "maxScale": 1.3
    },
    "title": {
      "font": "display",
      "size": 30,
      "lineHeight": 36,
      "weight": "800",
      "letterSpacing": -0.3,
      "maxScale": 1.4
    },
    "heading": {
      "font": "display",
      "size": 20,
      "lineHeight": 26,
      "weight": "600",
      "letterSpacing": -0.2,
      "maxScale": 1.6
    },
    "body": {
      "font": "body",
      "size": 16,
      "lineHeight": 23,
      "weight": "400",
      "letterSpacing": 0,
      "maxScale": 2.0
    },
    "secondary": {
      "font": "body",
      "size": 14,
      "lineHeight": 20,
      "weight": "400",
      "letterSpacing": 0,
      "maxScale": 2.0
    },
    "meta": {
      "font": "body",
      "size": 12,
      "lineHeight": 16,
      "weight": "600",
      "letterSpacing": 0.6,
      "maxScale": 1.6,
      "uppercase": true
    },
    "mono": {
      "font": "mono",
      "size": 14,
      "lineHeight": 20,
      "weight": "500",
      "letterSpacing": 0,
      "maxScale": 1.6
    }
  },
  "size": {
    "xs": 12,
    "sm": 14,
    "md": 16,
    "lg": 20,
    "xl": 30,
    "xxl": 40
  },
  "space": {
    "xs": 4,
    "sm": 8,
    "md": 16,
    "lg": 24,
    "xl": 32,
    "xxl": 48
  },
  "radius": {
    "sm": 10,
    "md": 18,
    "lg": 24,
    "pill": 999
  },
  "motion": {
    "duration": {
      "instant": 90,
      "fast": 150,
      "standard": 260,
      "screen": 360,
      "deliberate": 520,
      "ambient": 1600
    },
    "easing": {
      "standard": [
        0.2,
        0,
        0,
        1
      ],
      "enter": [
        0.34,
        1.3,
        0.64,
        1
      ],
      "exit": [
        0.3,
        0,
        0.8,
        0.15
      ],
      "loop": [
        0.45,
        0,
        0.55,
        1
      ]
    },
    "spring": {
      "snappy": {
        "damping": 16,
        "stiffness": 300,
        "mass": 1
      },
      "gentle": {
        "damping": 16,
        "stiffness": 160,
        "mass": 1
      },
      "bouncy": {
        "damping": 9,
        "stiffness": 220,
        "mass": 1
      }
    },
    "pressScale": 0.95
  },
  "elevation": {
    "none": {
      "elevation": 0,
      "shadowOpacity": 0,
      "shadowRadius": 0,
      "shadowOffsetY": 0
    },
    "card": {
      "elevation": 2,
      "shadowOpacity": 0.08,
      "shadowRadius": 12,
      "shadowOffsetY": 4
    },
    "raised": {
      "elevation": 6,
      "shadowOpacity": 0.12,
      "shadowRadius": 20,
      "shadowOffsetY": 8
    },
    "overlay": {
      "elevation": 12,
      "shadowOpacity": 0.2,
      "shadowRadius": 32,
      "shadowOffsetY": 12
    }
  },
  "opacity": {
    "disabled": 0.45,
    "pressed": 0.12,
    "scrim": 0.45,
    "muted": 0.7
  },
  "icon": {
    "glyph": "S"
  },
  "minTapTarget": 48
}
